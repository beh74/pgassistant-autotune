# PostgreSQL service included in Compose (database/user: autotune).
# Use a URI-safe password here, or percent-encode it in AUTOTUNE_DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Fresh installations: Compose creates this named PostgreSQL 18 data volume.
# Existing installations can reference their current volume with EXTERNAL=true.
AUTOTUNE_DB_VOLUME_NAME=pgassistant-autotune-data
AUTOTUNE_DB_VOLUME_EXTERNAL=false
AUTOTUNE_DATABASE_URL=postgresql://autotune:${POSTGRES_PASSWORD}@db:5432/autotune
# Existing collector database: read access to its recommendation snapshots.
AUTOTUNE_COLLECTOR_DATABASE_URL=postgresql://reader:change-me@host.docker.internal:5432/collector
AUTOTUNE_API_KEY=replace-with-a-long-random-secret
# Host-side policy file mounted as AUTOTUNE_POLICY_PATH inside the containers.
# Use ./config/policy_ops.yaml for the OPS execution policy.
AUTOTUNE_POLICY_FILE=./config/policy.yaml
# Target addresses and users are defined in config/sources.yaml.
DEMO_DB_PASSWORD=change-me
